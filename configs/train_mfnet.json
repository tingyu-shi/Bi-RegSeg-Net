{
    "mode": "train",
    "dataset": "MFNet",
    "root": "../../dataset/MFNet",
    "n_classes": 9,
    "class_weight": "enet",
    "height": 576,
    "width": 768,
    "pad_height": 48,
    "pad_width": 64,
    "backbone": "vmamba_tiny",

    "normalize": false,
    "mean": [0.4, 0.4, 0.4],
    "std": [0.2, 0.2, 0.2],
    "#": "flip the image",
    "flip_prob": 0.5,
    "#": "crop the image",
    "crop_rate": 0.1,
    "crop_prob": 1.0,

    "#": "save path for checkpoint",
    "save_ckpt": "./checkpoints/mfnet",
    "#": "load path for checkpoint",
    "load_ckpt": "./checkpoints/mfnet/2025-05-13-11-38-04(MFNet-train-Reg)_epoch_484_MSE_0.0004_NCC_0.9884_MI_1.6920_PCK_93.0343.pth",

    "#": "dataset resides in memory",
    "in_memory": false,
    "#": "batch size",
    "batch_size": 2,
    "#": "child process used by the data load",
    "num_workers": 4,
    "#": "GPU ID number(s), -1 denote CPU (default: 0), e.g., \"0\" and \"-1\"",
    "gpu": "0",

    "#": "number of training epochs",
    "epochs": 500,
    "#": "learning rate",
    "lr_start_reg": 1e-4,
    "lr_start_seg": 6e-5,
    "lr_decay": 0.99,
    "weight_decay": 0.01
}