{
    "mode": "test",
    "dataset": "FMB",
    "root": "../../dataset/FMB",
    "n_classes": 15,
    "class_weight": "enet",
    "height": 600,
    "width": 800,
    "backbone": "vmamba_tiny",

    "normalize": true,

    "#": "the bast checkpoint path",
    "load_ckpt": "./checkpoints/fmb/model.pth",

    "#": "save predict image",
    "save_image": "./results/fmb",

    "#": "dataset resides in memory",
    "in_memory": false,
    "#": "batch size",
    "batch_size": 16,
    "#": "child process used by the data load",
    "num_workers": 10,
    "#": "GPU ID number(s), -1 denote CPU, e.g., \"-1\" and \"0\"",
    "gpu": "0"
}
